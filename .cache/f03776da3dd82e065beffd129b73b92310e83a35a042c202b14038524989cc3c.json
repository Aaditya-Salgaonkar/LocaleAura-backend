  "results": [
    {
      "name": "Sabyasachi",
      "entity_id": "0CE37115-938A-4301-8544-2C74B30C2784",
      "types": [
        "urn:entity:brand"
      ],
      "properties": {
        "akas": [],
        "description": "Sabyasachi is a world-renowned luxury fashion house representing the pinnacle of Indian bridal couture and fine jewelry. Established with a deep commitment to preserving and reviving indigenous Indian crafts and textiles, the brand is known for its intricate hand-embroidery and regal design language. Its offerings span elaborate wedding collections for men and women, alongside high-end jewelry that often draws inspiration from historical Indian aesthetics. By merging tradition with global luxury standards, the brand has become a hallmark of opulence and cultural prestige for high-net-worth clients worldwide.",
        "external": {
          "instagram": {
            "id": "sabyasachiofficial"
          }
        },
        "founded_year": "1999",
        "image": {
          "url": "https://images.qloo.com/i/0CE37115-938A-4301-8544-2C74B30C2784-420x-auto.jpg"
        },
        "short_description": "Sabyasachi is a luxury Indian brand known for high jewellery, fine jewellery, womenswear, menswear, weddings, and accessories.",
        "short_descriptions": [
          {
            "language": "es",
            "value": "Una marca de lujo de gran opulencia arraigada en la tradición india, celebrada por su costura nupcial, alta joyería y exquisita artesanía."
          },
          {
            "language": "en",
            "value": "An opulent luxury brand rooted in Indian tradition, celebrated for its intricate bridal couture, fine jewelry, and exquisite craftsmanship."
          },
          {
            "language": "fr",
            "value": "Une marque de luxe opulente ancrée dans la tradition indienne, célèbre pour sa couture nuptiale complexe, sa haute joaillerie et son artisanat exquis."
          },
          {
            "language": "de",
            "value": "Eine opulente Luxusmarke mit Wurzeln in der indischen Tradition, gefeiert für ihre komplexe Brautmode, feinen Schmuck und exquisite Handwerkskunst."
          }
        ]
      },
